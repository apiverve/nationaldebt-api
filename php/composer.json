{
    "name": "apiverve/nationaldebt",
    "description": "National Debt provides the US national debt (Debt to the Penny), updated daily from the Treasury. It returns the total public debt, debt held by the public, intragovernmental holdings, per-capita debt calculations, the previous record's total, and on paid plans how much the debt grew over a day, 30 days and a year.",
    "version": "1.2.4",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "nationaldebt",
        "national debt",
        "us debt",
        "public debt",
        "government debt",
        "debt to the penny"
    ],
    "homepage": "https://apiverve.com/marketplace/nationaldebt?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/nationaldebt",
        "source": "https://github.com/apiverve/nationaldebt-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Nationaldebt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Nationaldebt\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
